{
  "version": "1.1",
  "bundle": "progressive-site-skills",
  "default_mode": "guided",
  "skills": {
    "site-builder": {
      "version": "1.1",
      "directory": "site-builder",
      "role": "唯一编排与正式实施入口",
      "depends_on": ["site-brief", "site-design", "site-check"]
    },
    "site-brief": {
      "version": "1.1",
      "directory": "site-brief",
      "role": "核心任务与首版范围收敛",
      "depends_on": []
    },
    "site-design": {
      "version": "1.1",
      "directory": "site-design",
      "role": "完整设计知识、可见方向、体验稿、合同与只读审查",
      "depends_on": ["site-brief"]
    },
    "site-check": {
      "version": "1.1",
      "directory": "site-check",
      "role": "只读核心任务与视觉验证",
      "depends_on": ["site-design"]
    }
  }
}
