{
  "schemaVersion": "2.0",
  "id": "website-developer",
  "version": "1.2.0",
  "type": "agent",
  "ownership": "general",
  "name": "website-developer",
  "displayName": "网站开发专家",
  "description": "支持网站搭建、参考建站、设计灵感和体验升级。不用懂技术，不管是单位介绍、产品展示、活动报名还是日常事务登记，说清用途就行：先给你两版 Demo 对比，你点头我再动手，每步看得见、测得通。",
  "categoryId": "rd",
  "icon": "./agent/assets/logo.png",
  "iconAlt": "网站开发专家",
  "tags": [
    "网站开发",
    "机构门户",
    "产品展示",
    "品牌官网",
    "活动落地页"
  ],
  "agent": {
    "action": {
      "type": "conversation"
    },
    "quickPrompts": [
      {
        "id": "new-site",
        "text": "帮我做一个网站，把单位的基本情况、主要业务和联系方式讲清楚。"
      },
      {
        "id": "reference-link",
        "text": "我会给你一个喜欢的网站链接或截图，请照着它做一个我们自己的版本。"
      },
      {
        "id": "design-first",
        "text": "先别写代码，给我两版不同气质的设计看看，我挑一版再继续。"
      }
    ],
    "owner": "fde-dev",
    "visibility": {
      "departments": []
    },
    "defaultEnabled": true,
    "showcases": [
      {
        "id": "org-portal",
        "description": "核心业务、团队与联系入口放在一页，访客一眼看清你们做什么。",
        "mediaType": "image",
        "path": "./agent/assets/showcases/org-portal.png",
        "usage": "marketplace-preview"
      },
      {
        "id": "service-team",
        "description": "用成立时间、服务企业数和真实项目说明实力，并给出微信咨询入口。",
        "mediaType": "image",
        "path": "./agent/assets/showcases/service-team.png",
        "usage": "marketplace-preview"
      },
      {
        "id": "product-showcase",
        "description": "按品类陈列产品、价格和适用场景，没标价的引导访客到微信问。",
        "mediaType": "image",
        "path": "./agent/assets/showcases/product-showcase.png",
        "usage": "marketplace-preview"
      },
      {
        "id": "brand-page",
        "description": "一个长页讲完品牌故事、产品系列与到店信息，排版跟着品牌调性走。",
        "mediaType": "image",
        "path": "./agent/assets/showcases/brand-page.png",
        "usage": "marketplace-preview"
      }
    ]
  }
